# Secret para validar requisições do n8n no webhook
# Gere um valor seguro: openssl rand -hex 32
WEBHOOK_SECRET=troque-por-valor-seguro

# URL pública do app (usada pelo n8n para chamar o webhook)
# Em desenvolvimento: use ngrok ou similar
# Em produção: URL do seu servidor
NEXT_PUBLIC_APP_URL=http://localhost:3000
